# Membres du foyer, séparés par des virgules (choisis sur chaque appareil, stockés dans le navigateur)
HOUSEHOLD_MEMBERS=Alex,Sam

# Base de données : SQLite par défaut (fichier local). Postgres possible : postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./data/popote.db
DB_ECHO=false

# Génération et modification de recettes avec ChatGPT (Responses API + sortie Pydantic). Vide = désactivé.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Données de départ chargées au premier démarrage (si la base n'a aucune recette).
# data/private_seed.json est ignoré par git : membres par recette, notes du foyer, historique de courses.
SEED_ON_STARTUP=true
SEED_FILES=seed/recipes.json,seed/pantry.json,data/private_seed.json

# CORS (front Vite) et hôtes autorisés à appeler le serveur MCP (protection DNS rebinding)
ALLOWED_ORIGINS=*
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
